# Credentials
.env

# The source dataset: 708 MB, over GitHub's hard 100 MB per-file limit, so it
# cannot be committed. See "Getting transactions.csv" in README.md. The other
# three dataset files are small enough and ARE tracked.
/transactions.csv

# data/staging/ IS tracked, so the graph can be rebuilt without the 708 MB
# source. Two exceptions:
#   - the staged transaction file is 187 MB, so the gzipped twin is committed
#     instead and the loader reads either
#   - run logs and scratch files are noise
data/staging/transactions.csv
data/staging/*.log
data/staging/_*.parquet

__pycache__/
.pytest_cache/
*.duckdb
node_modules/
frontend/.next/
frontend/.env*.local
frontend/out/

# Backend runtime state and derived artefacts. cases/ IS tracked — it is the
# deliverable. runs/ holds the per-run trace, which is reconstructible.
backend/var/
runs/
.venv/


// Sentinel fraud-investigation schema  --  TigerGraph 4.x
// @GRAPHNAME@ is substituted with TG_GRAPH from .env by scripts/load_to_tigergraph.py
// Types are created globally, then bound into the graph, which keeps the script
// idempotent and avoids schema-change jobs on a fresh instance.

CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING,
  n_cards INT,
  n_txns INT,
  first_seen DATETIME,
  last_seen DATETIME
) WITH primary_id_as_attribute="true"

// card_id is derived: the card6 value ranked lexicographically within the
// customer -> C08623-K1, C08623-K2. Recovered by testing candidate rules against
// the 14,975 txn -> card_id pairs implied by the closed cases and the case pack;
// this rule reproduces all 14,975 exactly. See scripts/prepare_data.py.
CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,
  customer_id STRING,
  card1 STRING, card2 STRING, card3 STRING,
  network STRING,        // card4: visa / mastercard / amex / discover
  card5 STRING,
  card_type STRING,      // card6: credit / debit
  home_region STRING,    // modal addr1
  home_country STRING,   // modal addr2 (87 = home country)
  n_txns INT,
  n_online INT,
  n_in_person INT,
  median_amt DOUBLE,
  p95_amt DOUBLE,
  max_amt DOUBLE,
  n_regions INT,
  n_products INT,
  top_products STRING,
  first_seen DATETIME,
  last_seen DATETIME
) WITH primary_id_as_attribute="true"

CREATE VERTEX Transaction (
  PRIMARY_ID txn_id STRING,
  card_id STRING,
  customer_id STRING,
  ts DATETIME,
  txn_dt INT,            // original TransactionDT, seconds from dataset start
  amt DOUBLE,
  product STRING,        // ProductCD
  channel STRING,        // online / in_person
  risk_score DOUBLE,     // bank model output: an input, never a verdict
  addr1 STRING,          // billing region code, kept verbatim e.g. "444.0"
  addr2 STRING,          // billing country code, 87 = home
  dist1 DOUBLE,
  dist2 DOUBLE,
  p_email STRING,
  r_email STRING,
  device_key STRING,     // "" for in_person rows with no identity record
  device_new STRING,     // id_15: New / Found / NotFound
  proxy_flag STRING,     // id_23: IP_PROXY:TRANSPARENT / ANONYMOUS / HIDDEN
  match_status STRING,   // id_34
  c_feats STRING,        // C1..C14 pipe-joined, order in MetaDoc:packed_order
  d_feats STRING,        // D1..D15 pipe-joined
  m_feats STRING,        // M1..M9 pipe-joined
  v_feats STRING         // selected V columns as JSON
) WITH primary_id_as_attribute="true"

CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_key STRING,
  label STRING,          // "DeviceInfo | OS | browser | screen" -- the exact form
  device_info STRING,    //  used in answer files' connected_device_profiles
  device_type STRING,
  os STRING,
  browser STRING,
  screen STRING,
  n_txns INT,
  n_cards INT,
  n_customers INT
) WITH primary_id_as_attribute="true"

CREATE VERTEX BillingRegion (
  PRIMARY_ID region STRING,
  country STRING,
  n_txns INT,
  n_cards INT
) WITH primary_id_as_attribute="true"

CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING,
  n_txns INT
) WITH primary_id_as_attribute="true"

CREATE VERTEX ProductCode (
  PRIMARY_ID product STRING,
  channel_class STRING,
  n_txns INT
) WITH primary_id_as_attribute="true"

// The bank's finished investigations: labelled history and the agent's seed memory.
CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,        // confirmed_fraud / cleared
  pattern STRING,
  first_fraud_txn_id STRING,
  n_txns INT,
  exposure_usd DOUBLE,
  actions_taken STRING,
  report_filed STRING,
  analyst_notes STRING,
  emb LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

// Cases Sentinel itself opens (FraudCase: 'Case' is a reserved GSQL keyword). Written back during the run so a later case can
// retrieve an earlier one: this is the case memory that compounds.
CREATE VERTEX FraudCase (
  PRIMARY_ID case_id STRING,
  source_alert STRING,
  customer_id STRING,
  card_id STRING,
  status STRING,         // open / closed_fraud / closed_legitimate / escalated
  verdict STRING,        // fraud / legitimate / uncertain
  fraud_probability DOUBLE,
  pattern STRING,
  pattern_description STRING,
  exposure_usd DOUBLE,
  n_affected_txns INT,
  summary STRING,
  initial_actions STRING,
  final_actions STRING,
  sar_filed BOOL,
  stop_reason STRING,
  created_at DATETIME,
  created_by STRING,
  emb LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

// The 20 exam triggers, in the graph so the agent reads its work queue from
// TigerGraph rather than from a CSV on disk.
CREATE VERTEX Alert (
  PRIMARY_ID alert_id STRING,
  opened_at DATETIME,
  trigger_type STRING,   // risk_score / customer_report / analyst_request
  trigger_text STRING,
  flagged_txn_id STRING,
  card_id STRING,
  customer_id STRING,
  risk_score DOUBLE,
  status STRING
) WITH primary_id_as_attribute="true"

// Policy, the five documented patterns, and regulatory excerpts, for GraphRAG.
CREATE VERTEX PolicyDoc (
  PRIMARY_ID doc_id STRING,
  source STRING,
  section STRING,
  title STRING,
  text STRING,
  emb LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

// Loader contracts and provenance, so nothing downstream guesses at encodings.
CREATE VERTEX MetaDoc (
  PRIMARY_ID meta_id STRING,
  value STRING
) WITH primary_id_as_attribute="true"

// --- Edges -------------------------------------------------------------------

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, gap_seconds INT) WITH REVERSE_EDGE="PREV"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_USED_BY"
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_OF"
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="P_EMAIL_OF"
CREATE DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="R_EMAIL_OF"
CREATE DIRECTED EDGE OF_PRODUCT (FROM Transaction, TO ProductCode) WITH REVERSE_EDGE="PRODUCT_OF"

CREATE DIRECTED EDGE CC_INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="TXN_IN_CC"
CREATE DIRECTED EDGE CC_ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CARD_IN_CC"
CREATE DIRECTED EDGE CC_CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CC_CONNECTS"

CREATE DIRECTED EDGE CASE_INVOLVES (FROM FraudCase, TO Transaction) WITH REVERSE_EDGE="TXN_IN_CASE"
CREATE DIRECTED EDGE CASE_ON_CARD (FROM FraudCase, TO Card) WITH REVERSE_EDGE="CARD_IN_CASE"
CREATE DIRECTED EDGE CASE_CONNECTED_TO (FROM FraudCase, TO Card) WITH REVERSE_EDGE="CASE_CONNECTS"
CREATE DIRECTED EDGE CITES (FROM FraudCase, TO ClosedCase) WITH REVERSE_EDGE="CITED_BY"
CREATE DIRECTED EDGE CITES_CASE (FROM FraudCase, TO FraudCase) WITH REVERSE_EDGE="CITED_BY_CASE"
CREATE DIRECTED EDGE IMPLICATES (FROM FraudCase, TO DeviceProfile) WITH REVERSE_EDGE="IMPLICATED_IN"
CREATE DIRECTED EDGE APPLIED_RULE (FROM FraudCase, TO PolicyDoc) WITH REVERSE_EDGE="RULE_APPLIED_IN"
CREATE DIRECTED EDGE FROM_ALERT (FROM FraudCase, TO Alert) WITH REVERSE_EDGE="ALERT_CASE"

CREATE DIRECTED EDGE ALERT_ON_CARD (FROM Alert, TO Card) WITH REVERSE_EDGE="CARD_ALERTED"
CREATE DIRECTED EDGE ALERT_ON_TXN (FROM Alert, TO Transaction) WITH REVERSE_EDGE="TXN_ALERTED"

CREATE GRAPH @GRAPHNAME@ (
  Customer, Card, Transaction, DeviceProfile, BillingRegion, EmailDomain,
  ProductCode, ClosedCase, FraudCase, Alert, PolicyDoc, MetaDoc,
  OWNS, MADE, NEXT, FROM_DEVICE, BILLED_IN, PURCHASER_EMAIL, RECIPIENT_EMAIL,
  OF_PRODUCT, CC_INVOLVES, CC_ON_CARD, CC_CONNECTED_TO, CASE_INVOLVES,
  CASE_ON_CARD, CASE_CONNECTED_TO, CITES, CITES_CASE, IMPLICATES, APPLIED_RULE,
  FROM_ALERT, ALERT_ON_CARD, ALERT_ON_TXN
)
